        "w": 1
      }
    ]
  },
  "positive": {
    "normative_caps": {
      "re": "\\b(MUST NOT|MUST|SHALL NOT|SHALL|SHOULD NOT|SHOULD|MAY|REQUIRED|RECOMMENDED|OPTIONAL)\\b",
      "case": true
    },
    "normative_lower": {
      "re": "\\b(must not|must|shall not|shall|should not|is required to|are required to)\\b"
    },
    "quantities": {
      "re": "\\b\\d+(\\.\\d+)?\\s?(%|ms|µs|us|ns|s|sec|secs|seconds?|minutes?|mins?|hours?|days?|weeks?|[KMGTP]i?B|bytes?|octets?|bits?|req/s|rps|qps|x|times|percent|requests|nodes|replicas|cores|vCPUs?|connections)\\b"
    },
    "cross_refs": {
      "re": "(\\bSection \\d|\\bRFC ?\\d{3,5}\\b|§\\s?\\d|\\[RFC\\d+\\]|\\bAppendix [A-Z]\\b|\\bIEEE (Std )?\\d)"
    },
    "terminology_heading": {
      "re": "^(\\d+(\\.\\d+)*\\.?\\s+)?(terminology|definitions|glossary|conventions( and terminology)?|terms)\\b"
    }
  },
  "scoring": {
    "_comment": "Index thresholds per axis. An index at or below good scores 10, at or above bad scores 0, linear between. good is set from the gold set (RFCs and the Kubernetes architecture docs). See references/calibration.md.",
    "vocabulary": {
      "good": 1.0,
      "bad": 12
    },
    "filler": {
      "good": 0.8,
      "bad": 8
    },
    "rhetoric": {
      "good": 1.5,
      "bad": 10
    },
    "tone": {
      "good": 1.0,
      "bad": 10
    },
    "typography": {
      "good": 2.5,
      "bad": 20
    },
    "structure": {
      "good": 3.0,
      "bad": 12
    },
    "precision": {
      "good": 1.5,
      "bad": 10
    }
  },
  "weights": {
    "_comment": "Weight of each axis in the overall score. The last two are judged by the reviewer, not measured.",
    "vocabulary": 15,
    "filler": 10,
    "rhetoric": 15,
    "tone": 10,
    "typography": 10,
    "structure": 10,
    "precision": 10,
    "terminology": 10,
    "economy": 10
  },
